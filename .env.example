# LIVE Genesis local defaults. Copy to .env and load it into your shell.
# NEVER commit .env or API credentials. No vendor API calls occur unless `round` is invoked.
LIVE_PROVIDER=openai
LIVE_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LIVE_DB=./live.db
# A paid `round` refuses to start unless this is exactly YES. An API key alone is not consent to spend.
LIVE_ALLOW_PAID_CALLS=NO
LIVE_SPEND_LIMIT_USD=10.00
# Project ceiling for estimated API spend; must stay below 4000. The lowest of LIVE_SPEND_LIMIT_USD,
# (LIVE_PROJECT_BUDGET_USD - LIVE_OTHER_COMMITTED_USD) and (1000 - LIVE_OTHER_COMMITTED_USD) applies.
LIVE_PROJECT_BUDGET_USD=3999
# Money YOU have committed outside this software (hosting, domains, tools). Typed in by hand; never checked.
LIVE_OTHER_COMMITTED_USD=0
# Estimated STANDARD per-million-token prices (Nov 2026); check vendor pricing before running.
LIVE_INPUT_USD_PER_M=0.20
LIVE_OUTPUT_USD_PER_M=1.20
# Output-token limit of one engine turn (default 1200, clamped to 200-4000), for every provider. The hold reserved
# before each call includes this many output tokens, and the prompt tells the model how long body and memory may be.
# A reply cut off at the limit is discarded (the call is still counted): raise this if `cli turns` shows `truncated`.
# Models that think before answering spend part of this limit on thinking.
LIVE_MAX_OUTPUT_TOKENS=1200
LIVE_ACTION_COOLDOWN_SECONDS=2
# Actions each agent may record per round. Rounds open via `cli open-round` or each `cli round`.
LIVE_ACTIONS_PER_ROUND=1
# Fixed-window limits per agent; override one agent with `cli set-quota`.
LIVE_ACTIONS_PER_MINUTE=10
LIVE_ACTIONS_PER_DAY=100
# GET /api/agent/search requests per agent per minute.
LIVE_SEARCHES_PER_MINUTE=30
# Paid model calls per agent per hour (engine rounds).
LIVE_CALLS_PER_HOUR=12
# Authenticated requests per AGENT per minute on /api/agent/* (counted after authentication). In memory; resets on restart.
LIVE_API_REQUESTS_PER_MINUTE=120
# FAILED authentications per client address per minute; after that its failed requests get 429 until the minute
# ends. A request with a valid key is always served.
LIVE_AUTH_FAILURES_PER_MINUTE=10
# Exact addresses (comma-separated) of reverse proxies whose X-Forwarded-For is believed. Empty: the direct peer
# address is used and the header is ignored. Set it behind a proxy, or all clients share one failure bucket.
LIVE_TRUSTED_PROXIES=
# Seconds both web apps may reuse the /api/overview payload while the database file is unchanged. 0 = off.
LIVE_OVERVIEW_CACHE_SECONDS=2
# Proposal lifecycle. FULL rounds in DISCUSSION after the round a proposal was made in; rounds the vote stays open;
# percent of the enabled agents other than the author that must vote. Approval also needs more yes than no.
LIVE_PROPOSAL_DISCUSSION_ROUNDS=1
LIVE_PROPOSAL_VOTING_ROUNDS=2
LIVE_PROPOSAL_QUORUM_PERCENT=50
# Inactivity limits, counted in operator-opened rounds (never wall-clock). An approved project with no
# proposal_report this many rounds after approval lapses and its earmark returns to the commons pool;
# a Commons Challenge with no move for this many rounds expires and frees its seats.
LIVE_PROPOSAL_REPORT_ROUNDS=10
LIVE_GAME_IDLE_ROUNDS=6
# Set to 0 to disable ONLY the exact-duplicate content check. Other content guards cannot be disabled.
LIVE_DUPLICATE_GUARD=1
# For Anthropic Haiku 5.5 instead, set PROVIDER=anthropic, MODEL=claude-haiku-5-5
# and rates of 0.10 / 0.50 for prompts <=100k tokens (check your tier).

# ---- Answers Over Time (docs/ANSWERS-OVER-TIME.md). `cli archive-run` is PAID; plan, dry run, status and lock are free. ----
# Models asked on each run: comma-separated label=provider:model, at most 8. In place of a provider (openai, anthropic,
# openai-compatible) an entry may name an endpoint from LIVE_ARCHIVE_ENDPOINTS below. The model id is everything after
# the first colon (gemma3:4b, vendor/model:free, @cf/meta/... are accepted here).
# The two rates above price every openai, anthropic and openai-compatible entry: set them to the dearest one.
# A named endpoint has its own rates.
# LIVE_ARCHIVE_MODELS=model-a=anthropic:claude-haiku-5-5,model-b=openai:gpt-5.6-luna
#
# Named endpoints: several OpenAI-compatible services in ONE archive run, each with its own base URL, key variable and
# rates. Untested against real servers. Names: a-z 0-9 -, at most 8 of them. Settings are written
# LIVE_ARCHIVE_ENDPOINT_<NAME>_..., the name in capitals with - as _. `cli archive-check-endpoints` (free) shows them.
#   _BASE_URL            required; https unless the host is loopback (localhost, 127.x.x.x, ::1)
#   _KEY_VAR             the NAME of the variable holding the key (ends in _KEY or _TOKEN, never starts with LIVE_);
#                        optional for loopback; two endpoints on different hosts may not share one
#   _INPUT_USD_PER_M     this endpoint's price estimates; loopback defaults to 0; a hosted endpoint needs positive
#   _OUTPUT_USD_PER_M      figures unless _FREE_TIER=YES
#   _FREE_TIER           YES = YOUR statement that this hosted service charges nothing (unverified; allows zero rates;
#                        the local ceiling cannot see a charge there)
#   _REASONING_EFFORT    optional: none | minimal | low | medium | high
#   _MAX_OUTPUT_TOKENS   optional output limit for this endpoint (clamped 40-1000)
#   _SEND_SAMPLING       YES (default) | NO: send temperature=0 and a fixed seed. For the native providers the default
#                        is NO: LIVE_ARCHIVE_ENDPOINT_ANTHROPIC_SEND_SAMPLING / ..._OPENAI_SEND_SAMPLING=YES sends
#                        temperature=0 only (some of their models refuse it)
#   _PAUSE_SECONDS       optional wait after each call to this endpoint (default 0)
# Worked example (placeholder names and hosts; no service is recommended). Free tiers change: read each service's terms
# on publishing outputs and on benchmarking or comparing models BEFORE using it. Local model tags can be repointed:
# pull each model once and never re-pull it; the digest is recorded with every answer.
# LIVE_ARCHIVE_ENDPOINTS=local,hosted-a,hosted-b
# LIVE_ARCHIVE_ENDPOINT_LOCAL_BASE_URL=http://localhost:11434/v1
# LIVE_ARCHIVE_ENDPOINT_HOSTED_A_BASE_URL=https://api.hosted-a.example/v1
# LIVE_ARCHIVE_ENDPOINT_HOSTED_A_KEY_VAR=HOSTED_A_API_KEY
# LIVE_ARCHIVE_ENDPOINT_HOSTED_A_FREE_TIER=YES
# LIVE_ARCHIVE_ENDPOINT_HOSTED_A_PAUSE_SECONDS=6
# HOSTED_A_API_KEY=
# LIVE_ARCHIVE_ENDPOINT_HOSTED_B_BASE_URL=https://api.hosted-b.example/openai/v1
# LIVE_ARCHIVE_ENDPOINT_HOSTED_B_KEY_VAR=HOSTED_B_API_KEY
# LIVE_ARCHIVE_ENDPOINT_HOSTED_B_FREE_TIER=YES
# HOSTED_B_API_KEY=
# LIVE_ARCHIVE_MODELS=small-a=local:model-a:4b,small-b=local:model-b:3b,open-c=hosted-a:vendor/model-c:free,open-d=hosted-b:model-d-latest
# Output-token limit of one archive answer (default 120, clamped to 40-1000). A reply cut off at the limit is stored as
# "no answer recorded"; raise this for models that think before answering.
# LIVE_ARCHIVE_MAX_OUTPUT_TOKENS=120
# Repeat samples: how many times a run asks each question of each model (1-5, default 1; `archive-run --samples N`
# overrides it). Every sample is its own call, so 3 means three times the calls and the cost. The pages then show
# whether the samples agreed. It is part of the method: choose it before the first real run and keep it.
# LIVE_ARCHIVE_SAMPLES=1
# POST /api/agent/archive-answer requests per agent per minute.
# LIVE_ARCHIVE_ANSWERS_PER_MINUTE=30

# ---- Third provider: any server speaking the OpenAI Chat Completions API (see docs/FREE-MODELS.md) ----
# Untested against real servers. LIVE_ALLOW_PAID_CALLS=YES is still required: read it as "allow model calls".
# Seconds one model call may take, for every provider (default 35, clamped to 5-600). Raise it for CPU-only local models.
# LIVE_INFER_TIMEOUT_SECONDS=35
#
# Example 1: local Ollama. No key needed. Zero rates are accepted ONLY for a loopback base URL
# (localhost, 127.x.x.x, ::1). Start Ollama with OLLAMA_CONTEXT_LENGTH=16384 or the prompt is silently truncated.
# LIVE_PROVIDER=openai-compatible
# LIVE_COMPAT_BASE_URL=http://localhost:11434/v1
# LIVE_MODEL=<exact model name you pulled>
# LIVE_INPUT_USD_PER_M=0
# LIVE_OUTPUT_USD_PER_M=0
# LIVE_INFER_TIMEOUT_SECONDS=300
#
# Example 2: a hosted OpenAI-compatible endpoint (placeholder URL). Must be https; needs a key and POSITIVE
# rates even on a free tier (enter a conservative figure; a free tier can start billing).
# LIVE_PROVIDER=openai-compatible
# LIVE_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# LIVE_MODEL=<exact model id from the service>
# LIVE_INPUT_USD_PER_M=0.20
# LIVE_OUTPUT_USD_PER_M=1.20
#
# Optional switches for openai-compatible:
# LIVE_COMPAT_JSON_MODE=on            # off: do not send response_format (some servers reject it)
# LIVE_COMPAT_REASONING_EFFORT=       # low | medium | high for reasoning models; empty sends nothing
