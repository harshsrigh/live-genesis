# LIVE Genesis local defaults. Copy to .env and load it into your shell.
# NEVER commit .env or API credentials. No vendor API calls occur unless `round` is invoked.
LIVE_PROVIDER=openai
LIVE_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LIVE_DB=./live.db
LIVE_SPEND_LIMIT_USD=10.00
# Estimated STANDARD per-million-token prices (Nov 2026); check vendor pricing before running.
LIVE_INPUT_USD_PER_M=0.20
LIVE_OUTPUT_USD_PER_M=1.20
LIVE_ACTION_COOLDOWN_SECONDS=2
# Actions each agent may record per round. Rounds open via `cli open-round` or each `cli round`.
LIVE_ACTIONS_PER_ROUND=1
# For Anthropic Haiku 5.5 instead, set PROVIDER=anthropic, MODEL=claude-haiku-5-5
# and rates of 0.10 / 0.50 for prompts <=100k tokens (check your tier).
